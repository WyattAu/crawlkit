# Template: GitHub Actions workflow for crawlkit WASM plugin repositories.
#
# `crawlkit plugin new` copies this file into scaffolded plugin projects as
# .github/workflows/plugin-ci.yml. It provides:
#
#   1. test       — rustfmt + clippy + unit tests on the native target
#   2. build-wasm — release build for wasm32-unknown-unknown
#   3. publish    — on GitHub Releases only: builds, hashes, signs with the
#                   CRAWLKIT_SIGNING_KEY secret (hex ed25519 seed from
#                   `crawlkit plugin keygen`), and emits a signed plugin
#                   index + artifact as a downloadable/uploadable bundle
#
# Required repository secret:
#   CRAWLKIT_SIGNING_KEY — 64 hex characters (32-byte ed25519 seed).
#   Never commit the matching secret key; the public key can be shared so
#   index maintainers can add it to their trust store.
name: Plugin CI

on:
  push:
    branches: [main]
  pull_request:
  release:
    types: [published]

concurrency:
  group: plugin-ci-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

env:
  CARGO_TERM_COLOR: always
  RUSTFLAGS: "-D warnings"

jobs:
  test:
    name: Test
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: dtolnay/rust-toolchain@4cda84d5c5c54efe2404f9d843567869ab1699d4 # stable
        with:
          components: clippy, rustfmt
      - uses: Swatinem/rust-cache@49a0bdc70d2e1b713ca9e2869b211fcce03d3c1c # v2
      - run: cargo fmt --check
      - run: cargo clippy --all-targets -- -D warnings
      - run: cargo test --all-targets

  build-wasm:
    name: Build (wasm32-unknown-unknown)
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: dtolnay/rust-toolchain@4cda84d5c5c54efe2404f9d843567869ab1699d4 # stable
        with:
          targets: wasm32-unknown-unknown
      - uses: Swatinem/rust-cache@49a0bdc70d2e1b713ca9e2869b211fcce03d3c1c # v2
      - run: cargo build --release --target wasm32-unknown-unknown

  publish:
    name: Sign and publish
    # Publishing is a deliberate release event: it runs only on GitHub
    # Releases, after both checks pass.
    if: github.event_name == 'release'
    needs: [test, build-wasm]
    runs-on: ubuntu-latest
    timeout-minutes: 15
    environment: plugin-publish
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: dtolnay/rust-toolchain@4cda84d5c5c54efe2404f9d843567869ab1699d4 # stable
        with:
          targets: wasm32-unknown-unknown
      - uses: Swatinem/rust-cache@49a0bdc70d2e1b713ca9e2869b211fcce03d3c1c # v2
      - name: Build, hash, sign, and update the plugin index
        env:
          CRAWLKIT_SIGNING_KEY: ${{ secrets.CRAWLKIT_SIGNING_KEY }}
        run: |
          cargo install crawlkit --locked
          crawlkit plugin publish . --index dist/plugin-index.toml
      - name: Upload signed plugin bundle
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: plugin-artifacts
          path: dist/
          if-no-files-found: error
